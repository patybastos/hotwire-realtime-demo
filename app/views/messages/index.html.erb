<% content_for :title, "Realtime room" %>

<main class="chat-shell" data-controller="chat">
	<header class="chat-header">
		<div>
			<p class="eyebrow">Hotwire lab / 01</p>
			<h1>Realtime room</h1>
		</div>
		<span class="connection-status"><span></span> live</span>
	</header>

	<section class="conversation" data-chat-target="conversation">
		<%= turbo_stream_from "messages" %>
		<div id="messages" class="messages">
			<% if @messages.empty? %>
				<p class="empty-state">The room is quiet. Start the conversation.</p>
			<% else %>
				<%= render @messages %>
			<% end %>
		</div>
	</section>

	<%= form_with model: @message, class: "message-form" do |form| %>
		<div class="form-row">
			<%= form.label :username, "Your name" %>
			<%= form.text_field :username, placeholder: "Ada", autocomplete: "nickname", required: true %>
		</div>
		<div class="composer-row">
			<%= form.text_area :content, placeholder: "Write a message...", rows: 2, required: true, data: { chat_target: "input" } %>
			<%= form.button "Send", class: "send-button" %>
		</div>
		<% if @message.errors.any? %>
			<p class="form-error"><%= @message.errors.full_messages.to_sentence %></p>
		<% end %>
	<% end %>
</main>
<h1>Messages#index</h1>
<p>Find me in app/views/messages/index.html.erb</p>
